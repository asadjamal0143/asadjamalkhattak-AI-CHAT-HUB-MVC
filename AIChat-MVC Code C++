class ChatBotController {
private:
    ChatBotModel model;
    ChatBotView view;
    bool running;
    
public:
    ChatBotController();
    void run();
    
private:
    void processInput(const std::string& input);
    void handleMenuChoice(int choice);
    void chatMode();
};

#endif

// ==================== Controller.cpp ====================
#include "Controller.h"

ChatBotController::ChatBotController() : model("SmartBot"), running(true) {}

void ChatBotController::run() {
    view.displayWelcome(model.getBotName());
    
    while (running) {
        view.displayMenu();
        int choice = view.getMenuChoice();
        handleMenuChoice(choice);
    }
    
    view.displayGoodbye();
}

void ChatBotController::handleMenuChoice(int choice) {
    switch (choice) {
        case 1:
            chatMode();
            break;
        case 2:
            model.switchResponder(false);
            view.displayResponse("Switched to Rule-based responder");
            break;
        case 3:
            model.switchResponder(true);
            view.displayResponse("Switched to AI responder");
            break;
        case 4:
            model.showHistory();
            break;
        case 5: {
            std::cout << "Enter filename to save: ";
            std::string filename;
            std::getline(std::cin, filename);
            try {
                model.saveChat(filename);
                view.displayResponse("Chat saved successfully!");
            } catch (const std::exception& e) {
                view.displayError(e.what());
            }
            break;
        }
        case 6: {
            std::cout << "Enter filename to load: ";
            std::string filename;
            std::getline(std::cin, filename);
            try {
                model.loadChat(filename);
                view.displayResponse("Chat loaded successfully!");
            } catch (const std::exception& e) {
                view.displayError(e.what());
            }
            break;
        }
        case 7:
            running = false;
            break;
        default:
            view.displayError("Invalid choice. Please try again.");
    }
}

void ChatBotController::chatMode() {
    view.displayResponse("Entering chat mode. Type 'exit' to return to menu.");
    
    while (true) {
        std::string input = view.getUserInput();
        
        if (input == "exit" || input == "quit") {
            break;
        }
        
        try {
            std::string response = model.getResponse(input);
            view.displayResponse(response);
        } catch (const std::exception& e) {
            view.displayError(e.what());
        }
    }
}

// ==================== main.cpp ====================
#include "Controller.h"

int main() {
    try {
        ChatBotController controller;
        controller.run();
    } catch (const std::exception& e) {
        std::cerr << "Fatal error: " << e.what() << std::endl;
        return 1;
    }
    
    return 0;
}